<%- include('partials/head', { title: 'Explore Campus | Room for Improvement' }) %>

    <body>
        <%- include('partials/nav') %>

        <%
          // ── Server-side rating color helpers ──────────────────────────────
          function ratingColor(val) {
            var colors = { 5: '#34877A', 4: '#92B89D', 3: '#D69772', 2: '#C27654', 1: '#AE5436' };
            return colors[Math.round(val)] || 'transparent';
          }

          var categories = [
            { key: 'culture',     icon: '🏆', label: 'Culture',
              textLabel: function(v) {
                if (v >= 4.5) return 'Very Positive';
                if (v >= 3.5) return 'Positive';
                if (v >= 2.5) return 'Neutral';
                if (v >= 1.5) return 'Negative';
                return 'Very Negative';
              }
            },
            { key: 'roomSize',    icon: '📦', label: 'Size',
              textLabel: function(v) {
                if (v >= 4.5) return 'Expansive';
                if (v >= 3.5) return 'Spacious';
                if (v >= 2.5) return 'Average';
                if (v >= 1.5) return 'Tight';
                return 'Cramped';
              }
            },
            { key: 'quietness',   icon: '🔇', label: 'Noise',
              textLabel: function(v) {
                if (v >= 4.5) return 'Silent';
                if (v >= 3.5) return 'Quiet';
                if (v >= 2.5) return 'Moderate';
                if (v >= 1.5) return 'Noisy';
                return 'Very Noisy';
              }
            },
            { key: 'tempControl', icon: '🌡️', label: 'Temp',
              textLabel: function(v) {
                if (v >= 4.5) return 'Very Easy';
                if (v >= 3.5) return 'Easy';
                if (v >= 2.5) return 'Manageable';
                if (v >= 1.5) return 'Difficult';
                return 'Very Difficult';
              }
            },
            { key: 'sunlight',    icon: '☀️', label: 'Nat. Light',
              textLabel: function(v) {
                if (v >= 4.5) return 'Very Bright';
                if (v >= 3.5) return 'Bright';
                if (v >= 2.5) return 'Moderate';
                if (v >= 1.5) return 'Dim';
                return 'Very Dark';
              }
            }
          ];

          // ── Overall ranking (per-dorm). Dorms with no scores are still
          //    given a slot but flagged unranked so each building still gets
          //    a visible bubble on the map (the user's explicit request).
          var dormOverall = (dormScores || []).map(function(d) {
            var vals = categories.map(function(c) { return d.scores[c.key]; })
                                 .filter(function(v) { return v != null; });
            var overall = vals.length ? vals.reduce(function(a, b) { return a + b; }, 0) / vals.length : null;
            return { name: d.name, overall: overall };
          });
          var ranked = dormOverall.slice().filter(function(d) { return d.overall != null; })
                                  .sort(function(a, b) { return b.overall - a.overall; });
          var dormRankByName = {};
          ranked.forEach(function(d, i) { dormRankByName[d.name] = i + 1; });
          var dormOverallByName = {};
          dormOverall.forEach(function(d) { dormOverallByName[d.name] = d.overall; });
        %>

        <%- include('partials/ratingColors') %>

        <main class="explore-page explore-3d-page explore-fullscreen">

            <!-- ====== 3D CAMPUS MAP (full screen below navbar) ====== -->
            <section class="explore-map-3d-section explore-map-3d-section--full">
                <div id="campus-3d-canvas-wrap" class="campus-3d-canvas-wrap campus-3d-canvas-wrap--full" data-testid="explore-map">
                    <canvas id="campus-3d-canvas" aria-label="3D map of UChicago campus dorms"></canvas>

                    <!-- 2D overlay for dorm labels + rank circles — rendered in
                         screen space so sizing/spacing is uniform regardless
                         of camera distance. Positioned each frame via JS. -->
                    <div id="dorm-labels-overlay" class="dorm-labels-overlay" aria-hidden="true"></div>

                    <!-- Road name labels — subtle, low-contrast, positioned at
                         the midpoint of each major road and updated each frame. -->
                    <div id="road-labels-overlay" class="road-labels-overlay" aria-hidden="true"></div>

                    <!-- Hover guide card: a single focused card that follows
                         the hovered dorm. Built once, populated on hover. -->
                    <aside id="dorm-hover-card" class="dorm-hover-card" aria-hidden="true" data-testid="dorm-rank-card">
                      <header class="dorm-hover-card__header">
                        <div>
                          <div class="dorm-hover-card__rank" id="dorm-hover-rank">—</div>
                          <div class="dorm-hover-card__rank-sub" id="dorm-hover-rank-sub">Unranked</div>
                        </div>
                        <div class="dorm-hover-card__title-wrap">
                          <h2 class="dorm-hover-card__title" id="dorm-hover-title"></h2>
                          <div class="dorm-hover-card__meta" id="dorm-hover-meta"></div>
                        </div>
                      </header>
                      <div class="dorm-hover-card__scores" id="dorm-hover-scores"></div>
                      <footer class="dorm-hover-card__footer" id="dorm-hover-footer"></footer>
                      <div class="dorm-hover-card__hint">Click to zoom in · Open dorm page →</div>
                    </aside>

                    <!-- 2D Compass overlay — single compass for the entire map -->
                    <div id="compass-2d" style="position:absolute; bottom:20px; left:20px; z-index:20; pointer-events:none;
                         width:100px; height:100px; display:flex; align-items:center; justify-content:center; transition:opacity 0.3s ease;">
                      <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Outer ring -->
                        <circle cx="50" cy="50" r="34" stroke="rgba(128,0,0,0.35)" stroke-width="1.5" fill="rgba(255,255,255,0.82)"/>
                        <!-- Inner tick marks at N/E/S/W -->
                        <line x1="50" y1="16" x2="50" y2="20" stroke="rgba(128,0,0,0.3)" stroke-width="1"/>
                        <line x1="50" y1="80" x2="50" y2="84" stroke="rgba(128,0,0,0.3)" stroke-width="1"/>
                        <line x1="16" y1="50" x2="20" y2="50" stroke="rgba(128,0,0,0.3)" stroke-width="1"/>
                        <line x1="80" y1="50" x2="84" y2="50" stroke="rgba(128,0,0,0.3)" stroke-width="1"/>
                        <!-- N arrow (up) — north half of diamond, filled maroon -->
                        <polygon points="50,22 44,50 50,46 56,50" fill="#800000"/>
                        <!-- S arrow (down) — south half of diamond, lighter -->
                        <polygon points="50,78 56,50 50,54 44,50" fill="rgba(128,0,0,0.25)"/>
                        <!-- E arrow (right) -->
                        <polygon points="78,50 50,44 54,50 50,56" fill="rgba(128,0,0,0.25)"/>
                        <!-- W arrow (left) -->
                        <polygon points="22,50 50,56 46,50 50,44" fill="rgba(128,0,0,0.25)"/>
                        <!-- Center dot -->
                        <circle cx="50" cy="50" r="3" fill="#800000" opacity="0.5"/>
                        <!-- Cardinal labels — placed OUTSIDE the ring so they don't overlap arrows -->
                        <text x="50" y="10" text-anchor="middle" dominant-baseline="central" font-size="12" font-weight="800" fill="#800000" font-family="Inter, sans-serif">N</text>
                        <text x="50" y="92" text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="700" fill="rgba(128,0,0,0.55)" font-family="Inter, sans-serif">S</text>
                        <text x="92" y="51" text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="700" fill="rgba(128,0,0,0.55)" font-family="Inter, sans-serif">E</text>
                        <text x="8" y="51" text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="700" fill="rgba(128,0,0,0.55)" font-family="Inter, sans-serif">W</text>
                      </svg>
                    </div>

                    <!-- Walk routes toggle removed — feature always-on. See
                         WALK_ROUTES_ENABLED constant in the page script for
                         the backend kill-switch if the feature needs to be
                         disabled without removing the implementation. -->
                    <!-- Map filter panel -->
                    <div class="map-filter-bar" aria-label="Filter buildings by type" role="group">
                      <div class="map-filter-bar__header">
                        <span class="map-filter-bar__title">Filter</span>
                        <button class="map-filter-bar__clear" id="map-filter-clear" aria-label="Clear filter">Clear</button>
                      </div>
                      <button class="map-filter-chip" data-legend-type="dorm"    aria-pressed="false" style="--chip-color:#7a1f1f;">
                        <span class="map-filter-chip__dot"></span>
                        <span class="map-filter-chip__label">Dorms</span>
                        <span class="map-filter-chip__check" aria-hidden="true"></span>
                      </button>
                      <button class="map-filter-chip" data-legend-type="library" aria-pressed="false" style="--chip-color:#9a3412;">
                        <span class="map-filter-chip__dot"></span>
                        <span class="map-filter-chip__label">Libraries</span>
                        <span class="map-filter-chip__check" aria-hidden="true"></span>
                      </button>
                      <button class="map-filter-chip" data-legend-type="dining"  aria-pressed="false" style="--chip-color:#b45309;">
                        <span class="map-filter-chip__dot"></span>
                        <span class="map-filter-chip__label">Dining</span>
                        <span class="map-filter-chip__check" aria-hidden="true"></span>
                      </button>
                      <button class="map-filter-chip" data-legend-type="gym"     aria-pressed="false" style="--chip-color:#be123c;">
                        <span class="map-filter-chip__dot"></span>
                        <span class="map-filter-chip__label">Gyms</span>
                        <span class="map-filter-chip__check" aria-hidden="true"></span>
                      </button>
                      <button class="map-filter-chip" data-legend-type="culture" aria-pressed="false" style="--chip-color:#713f12;">
                        <span class="map-filter-chip__dot"></span>
                        <span class="map-filter-chip__label">Culture</span>
                        <span class="map-filter-chip__check" aria-hidden="true"></span>
                      </button>
                      <button class="map-filter-chip" data-legend-type="building" aria-pressed="false" style="--chip-color:#6b6b6b;">
                        <span class="map-filter-chip__dot"></span>
                        <span class="map-filter-chip__label">Other</span>
                        <span class="map-filter-chip__check" aria-hidden="true"></span>
                      </button>
                    </div>
                </div>
            </section>

        </main>

        <!-- Footer hidden on the full-screen Explore page so the map can
             fill the viewport below the navbar without producing scroll. -->
        <footer style="display:none;">
            <p>&copy; 2026 Room for Improvement</p>
        </footer>

        <!-- Injected JSON for client scripts -->
        <script id="all-houses-data" type="application/json"><%- allHousesJson %></script>
        <script id="dorm-scores-data" type="application/json"><%- dormScoresJson %></script>
        <script id="dorm-ranks-data" type="application/json"><%- JSON.stringify({ rankByName: dormRankByName, overallByName: dormOverallByName, total: ranked.length }) %></script>
        <script id="osm-roads-data" type="application/json"><%- osmRoadsJson %></script>
