                el.appendChild(textEl);
                roadLabelsOverlay.appendChild(el);
                roadLabelEls[r.name] = { wrap: el, text: textEl };
            });

            // Update road label screen positions each frame.
            // Labels fade out when the camera is zoomed in close (they're
            // only useful at the overview zoom level).
            function updateRoadLabels2D() {
                const r = wrap.getBoundingClientRect();
                const zoomRatio = cameraDistance / overviewDistance;
                // Fade in when zoomed out (overview), fade out when zoomed in
                const opacity = Math.max(0, Math.min(1, (zoomRatio - 0.55) / 0.25));
                roadLabelAnchors.forEach(rd => {
                    const elObj = roadLabelEls[rd.name];
                    if (!elObj) return;
                    const el = elObj.wrap;
                    const textEl = elObj.text;
                    if (opacity < 0.01) {
                        el.style.opacity = '0';
                        return;
                    }
                    const projected = rd.worldPos.clone().project(camera);
                    // Cull if behind camera or outside a generous screen margin
                    if (projected.z > 1) { el.style.opacity = '0'; return; }
                    const sx = (projected.x * 0.5 + 0.5) * r.width;
                    const sy = (-projected.y * 0.5 + 0.5) * r.height;
                    const margin = 60;
                    if (sx < -margin || sx > r.width + margin || sy < -margin || sy > r.height + margin) {
                        el.style.opacity = '0';
                        return;
                    }
                    el.style.left = sx + 'px';
                    el.style.top  = sy + 'px';

                    // Compute screen-space angle from the road's two endpoints
                    const projA = rd.worldPosA.clone().project(camera);
                    const projB = rd.worldPosB.clone().project(camera);
                    const sxA = (projA.x * 0.5 + 0.5) * r.width;
                    const syA = (-projA.y * 0.5 + 0.5) * r.height;
                    const sxB = (projB.x * 0.5 + 0.5) * r.width;
                    const syB = (-projB.y * 0.5 + 0.5) * r.height;
                    const angle = Math.atan2(syB - syA, sxB - sxA) * (180 / Math.PI);
                    textEl.style.transform = 'rotate(' + angle + 'deg)';

                    el.style.opacity = String(opacity);
                });
            }

            // 3D north arrow removed — replaced by a 2D compass in the UI overlay.

            // ── Render quad (green grass patch) ─────────────────────────────
