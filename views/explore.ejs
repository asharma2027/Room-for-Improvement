            grid.material.transparent = true;
            scene.add(grid);

            // ── Render roads (OSM) ──────────────────────────────────────────
            // ── Render roads (OSM, merged geometry) ────────────────────────
            // All segments of the same category are merged into a single
            // BufferGeometry → one draw call per category instead of ~15k.
            const ROAD_MATS = {
                street:  new THREE.MeshLambertMaterial({ color: 0x8a8a8a }),
                service: new THREE.MeshLambertMaterial({ color: 0xa0a0a0 }),
                path:    new THREE.MeshLambertMaterial({ color: 0xc0b89a }),
            };
            const ROAD_Y = { street: 0.10, service: 0.08, path: 0.06 };

            // Road label anchors — only named streets, no duplicates
            const roadLabelAnchors = [];
            const ROAD_LABEL_SKIP = new Set([
                'South Ingleside Avenue', 'South Blackstone Avenue',
                'South Cottage Grove Avenue', 'South Maryland Avenue', 'Payne Drive',
                'South Lake Park Avenue', 'South Lake Park Avenue West',
                '55th Street Bikeway', 'Corridor System',
            ]);
            const roadLabelSeen = new Set();

            // Accumulate geometries per category
            const roadGeosByCat = { street: [], service: [], path: [] };

            OSM_ROADS.forEach(rd => {
                const pts = rd.points;
                if (!pts || pts.length < 2) return;
                const cat = rd.category || 'street';
                const w   = rd.width_m || 4;
                const y   = ROAD_Y[cat] ?? 0.08;
                const bucket = roadGeosByCat[cat] || roadGeosByCat.street;

                for (let i = 0; i < pts.length - 1; i++) {
                    const ax = pts[i][0],   az = pts[i][1];
                    const bx = pts[i+1][0], bz = pts[i+1][1];
                    const dx = bx - ax, dz = bz - az;
                    const len = Math.sqrt(dx*dx + dz*dz);
                    if (len < 0.1) continue;

                    // Build a BoxGeometry, apply position+rotation via matrix,
                    // then store the transformed geometry for merging.
                    const geo = new THREE.BoxGeometry(w, 0.12, len);
                    const mat4 = new THREE.Matrix4();
                    mat4.makeRotationY(Math.atan2(dx, dz));
                    mat4.setPosition((ax+bx)/2, y, (az+bz)/2);
                    geo.applyMatrix4(mat4);
                    bucket.push(geo);
                }

                // Label anchor (one per unique named street)
                if (rd.name && cat === 'street'
                        && !ROAD_LABEL_SKIP.has(rd.name)
                        && !roadLabelSeen.has(rd.name)) {
                    roadLabelSeen.add(rd.name);
                    const mid = Math.floor(pts.length / 2);
                    roadLabelAnchors.push({
                        name: rd.name,
                        worldPos:  new THREE.Vector3(pts[mid][0], 0.5, pts[mid][1]),
                        worldPosA: new THREE.Vector3(pts[0][0], 0.5, pts[0][1]),
                        worldPosB: new THREE.Vector3(pts[pts.length-1][0], 0.5, pts[pts.length-1][1]),
                    });
                }
            });

            // Merge and add — one mesh per category (3 draw calls total for all roads)
            Object.entries(roadGeosByCat).forEach(([cat, geos]) => {
                if (!geos.length) return;
                const merged = mergeGeometries(geos, false);
                if (!merged) return;
                // Free individual geometries
                geos.forEach(g => g.dispose());
                const mesh = new THREE.Mesh(merged, ROAD_MATS[cat]);
                mesh.receiveShadow = true;
                scene.add(mesh);
            });

            // ── Create 2D road label elements ───────────────────────────────
            const roadLabelsOverlay = document.getElementById('road-labels-overlay');
            const roadLabelEls = {}; // name → DOM element
            roadLabelAnchors.forEach(r => {
