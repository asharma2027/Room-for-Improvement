        <script type="module">
            // ════════════════════════════════════════════════════════════════
            // 3D UChicago campus map
            // ════════════════════════════════════════════════════════════════
            // Buildings are drawn as simple cuboids placed at their real-world
            // (lat, lng), then projected to a local meter grid centered on the
            // Main Quad. See DORMS / LANDMARKS arrays below to add or edit
            // buildings — every other detail is derived from there.
            // ════════════════════════════════════════════════════════════════
            import * as THREE from 'three';
            import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';

            // Read server-computed dorm ranks for on-map ranking badges.
            var DORM_RANKS = { rankByName: {}, overallByName: {}, total: 0 };
            try { DORM_RANKS = JSON.parse(document.getElementById('dorm-ranks-data').textContent); } catch (e) {}

            // Server-rendered dorm score detail (for hover card).
            var DORM_SCORES = [];
            try { DORM_SCORES = JSON.parse(document.getElementById('dorm-scores-data').textContent); } catch (e) {}
            const DORM_SCORE_BY_NAME = {};
            DORM_SCORES.forEach(function(d) { DORM_SCORE_BY_NAME[d.name] = d; });

            // ── Precise building footprints (from UChicago ArcGIS) ───────────
            // A subset of buildings have polygon footprint data with real
            // outer rings, holes, and heights (in feet). Buildings that opt
            // into footprint rendering set `footprintId: '<id>'` on their
            // DORMS or LANDMARKS entry; the render loop picks the footprint
            // path when that field is present, otherwise it falls back to
            // the original cuboid code path so nothing else changes.
            var BUILDING_FOOTPRINTS = [];
            try { BUILDING_FOOTPRINTS = JSON.parse(document.getElementById('building-footprints-data').textContent); } catch (e) {}
            const FOOTPRINT_BY_ID = {};
            BUILDING_FOOTPRINTS.forEach(function(b) { FOOTPRINT_BY_ID[b.id] = b; });
            const FT_TO_M = 0.3048;

            // Origin (Main Quad) → local 0,0 in the scene
            const ORIGIN_LAT = 41.7895;
            const ORIGIN_LNG = -87.5995;
            const M_PER_DEG_LAT = 111320;
            const M_PER_DEG_LNG = 111320 * Math.cos(ORIGIN_LAT * Math.PI / 180);

            function latLngToXZ(lat, lng) {
                return {
                    x: (lng - ORIGIN_LNG) * M_PER_DEG_LNG,
                    z: -(lat - ORIGIN_LAT) * M_PER_DEG_LAT
                };
            }

            // ── Build a 3D extruded mesh from a footprint polygon part ───────
            // `part` has { outer: [[lon,lat]…], holes: [[[lon,lat]…]…], height_ft }.
            // Outer ring is converted to a THREE.Shape in the XY plane, with
            // (shape.x, shape.y) = (scene_x, -scene_z). Holes are added as
            // THREE.Path objects. ExtrudeGeometry extrudes along +Z; after
            // rotateX(-PI/2) the building stands from y=0 (ground) up to
            // y=height in scene coordinates, and the negated shape_y becomes
            // the correct positive scene_z.
            function buildFootprintMesh(part, mat) {
                const heightM = (part.height_ft || 30) * FT_TO_M;
                const shape = new THREE.Shape();
                // Shape (x, y) lives in the XY plane; after rotateX(-PI/2)
                // geo_y becomes -scene_z, so we store -p.z in shape_y so
                // the final scene_z equals p.z (matching the cuboid convention).
                (part.outer || []).forEach((pt, i) => {
                    const p = latLngToXZ(pt[1], pt[0]);
                    if (i === 0) shape.moveTo(p.x, -p.z);
                    else         shape.lineTo(p.x, -p.z);
                });
                if (part.holes && part.holes.length) {
                    part.holes.forEach(holeRing => {
                        const hole = new THREE.Path();
                        holeRing.forEach((pt, i) => {
                            const p = latLngToXZ(pt[1], pt[0]);
                            if (i === 0) hole.moveTo(p.x, -p.z);
                            else         hole.lineTo(p.x, -p.z);
                        });
                        shape.holes.push(hole);
                    });
                }
                const geo = new THREE.ExtrudeGeometry(shape, {
                    depth: heightM,
                    bevelEnabled: false,
                    steps: 1
                });
                geo.rotateX(-Math.PI / 2);

                // ── Re-center geometry so the mesh pivot is at the
                //    building's own XZ center with Y base at 0.
                // Without this, vertices are in world space and
                // scale.set() would expand from world origin, causing
                // buildings to drift on hover.
                geo.computeBoundingBox();
                const bb = geo.boundingBox;
                const cx = (bb.min.x + bb.max.x) / 2;
                const cz = (bb.min.z + bb.max.z) / 2;
                // Shift geometry so local XZ center is (0,0) and Y base stays at 0
                geo.translate(-cx, 0, -cz);
                const mesh = new THREE.Mesh(geo, mat);
                // Position the mesh at the world-space center we just removed
                mesh.position.set(cx, 0, cz);
                mesh.castShadow = true;
                mesh.receiveShadow = true;
                return mesh;
            }

            // ── Build a 3D mesh from pre-triangulated campus_north_mesh data ──
            //
            // COORDINATE SYSTEM NOTES (for future LLM/developer reference):
            //
            // campus_north_mesh.json format:
            //   v: flat array of XZ pairs [x0,z0, x1,z1, ...] for ALL vertices.
            //      First half (indices 0..nVerts/2-1) = bottom ring (y=0).
            //      Second half (indices nVerts/2..nVerts-1) = top ring (y=heightM).
            //      Both halves share the same XZ footprint.
            //   t: flat array of triangle vertex indices (3 per triangle).
            //      The mesh is a COMPLETE 3D SOLID: bottom face (~418 tris),
            //      top face (~418 tris), and side walls (~832 tris) are all
            //      pre-triangulated. Do NOT re-extrude.
            //
            // Vertices are already in explore page scene coordinates
            // (pre-converted by scripts/split_building_mesh.py).
            // Y values are assigned here: bottom half → 0, top half → heightM.
            //
            var CAMPUS_NORTH_MESH = null;
            try { CAMPUS_NORTH_MESH = JSON.parse(document.getElementById('campus-north-mesh-data').textContent); } catch(e) {}

            function buildFromMeshData(meshData, heightM, mat) {
                if (!meshData) return null;
                const flatV = meshData.v;
                const flatT = meshData.t;
                const nVerts = flatV.length / 2;   // total vertices (bottom + top halves)
                const nTris  = flatT.length / 3;

                // ── Mesh structure (campus_north_mesh.json) ──────────────────
                // The v array stores XZ pairs for ALL vertices as a flat list.
                // The mesh is already a complete 3D solid: bottom face, top face,
                // and side walls are all pre-triangulated.
                // Vertex layout: first half (indices 0..nVerts/2-1) = bottom ring
                //                second half (indices nVerts/2..nVerts-1) = top ring
                // Both halves share the same XZ coordinates; Y is assigned here:
                //   bottom half → y = 0
                //   top half    → y = heightM
                // Triangle indices reference this combined vertex array directly.
                const halfN = nVerts / 2;

                const positions = new Float32Array(nVerts * 3);
                for (let i = 0; i < nVerts; i++) {
                    positions[i * 3]     = flatV[i * 2];           // x
                    positions[i * 3 + 1] = i < halfN ? 0 : heightM; // y
                    positions[i * 3 + 2] = flatV[i * 2 + 1];       // z
                }

                const indices = new Uint32Array(flatT.length);
                for (let i = 0; i < flatT.length; i++) indices[i] = flatT[i];

                const geo = new THREE.BufferGeometry();
                geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
                geo.setIndex(new THREE.BufferAttribute(indices, 1));
                geo.computeVertexNormals();

                // Re-center geometry so the mesh pivot is at its XZ center
                // with Y base at 0. This matches the footprint mesh convention
                // used by buildFootprintMesh() — necessary for hover scaling
                // to expand from the building center rather than world origin.
                geo.computeBoundingBox();
                const bb = geo.boundingBox;
                const cx = (bb.min.x + bb.max.x) / 2;
                const cz = (bb.min.z + bb.max.z) / 2;
                geo.translate(-cx, 0, -cz);

                const mesh = new THREE.Mesh(geo, mat);
                // Position at the world-space center we subtracted from geometry
                mesh.position.set(cx, 0, cz);
                mesh.castShadow = true;
                mesh.receiveShadow = true;
                return mesh;
            }

            // Centroid (in scene XZ) of a footprint's outer ring vertices,
            // averaged across all parts. Used to anchor the 2D label.
            function footprintCentroid(parts) {
                let sx = 0, sz = 0, n = 0;
                (parts || []).forEach(part => {
                    (part.outer || []).forEach(pt => {
                        const p = latLngToXZ(pt[1], pt[0]);
                        sx += p.x; sz += p.z; n++;
                    });
                });
                return n > 0 ? { x: sx / n, z: sz / n } : { x: 0, z: 0 };
            }

            // Tallest part of a footprint (in meters), used for label height.
            function footprintMaxHeight(parts) {
                let max = 0;
                (parts || []).forEach(part => {
                    const h = (part.height_ft || 0) * FT_TO_M;
                    if (h > max) max = h;
                });
                return max;
            }

