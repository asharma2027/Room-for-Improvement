<%- include('partials/head', { title: 'Room Details | Room for Improvement' }) %>

  <body>
    <%- include('partials/nav') %>
    <style>
      /* Red asterisk for required fields */
      .req-star { color: #dc2626; font-weight: 700; margin-left: 0.15rem; }
      .opt-note { font-weight: normal; color: var(--text-secondary); font-size: 0.82rem; margin-left: 0.25rem; }

      /* Submit review CTA button */
      .review-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        background: #800000;
        color: #fff;
        padding: 0.7rem 1.4rem;
        border-radius: 0.5rem;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        box-shadow: 0 3px 12px rgba(128,0,0,0.28);
        transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
      }
      .review-cta-btn:hover {
        background: #660000;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(128,0,0,0.38);
        color: #fff;
        text-decoration: none;
      }
      .review-cta-btn svg {
        flex-shrink: 0;
      }

      /* Highlight animation for the latest submission after form submit */
      @keyframes reviewHighlight {
        0%   { background: #fef9c3; box-shadow: 0 0 0 3px #fbbf24; }
        60%  { background: #fef9c3; box-shadow: 0 0 0 3px #fbbf24; }
        100% { background: transparent; box-shadow: none; }
      }
      .review-just-submitted {
        animation: reviewHighlight 2.5s ease forwards;
        border-radius: 0.5rem;
        transition: background 0.4s, box-shadow 0.4s;
      }

      /* Big red moving gradient effect for custom room name */
      .custom-room-name {
        font-size: 3.2rem;
        font-weight: 900;
        text-transform: uppercase;
        background: linear-gradient(270deg, #8d0000, #aa3838, #440000, #8d0000);
        background-size: 300% 300%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: fireGradient 7.5s ease infinite;
        filter: drop-shadow(0px 3px 6px rgba(120, 0, 0, 0.4));
        margin-bottom: 0.4rem;
        margin-top: 0;
        letter-spacing: 1px;
        line-height: 1.15;
        overflow-wrap: break-word;
        word-wrap: break-word;
      }
      
      @keyframes fireGradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      /* Side-by-side visualizer + latest submission */
      .room-details-split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(300px, 600px);
        gap: 24px;
        margin-bottom: 2rem;
        align-items: start;
      }
      .room-details-split > .stat-card {
        max-width: 600px;
        width: 100%;
        margin: 0;
        box-sizing: border-box;
      }
      .room-viz-card {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #e4e7ec;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        min-width: 0;
      }
      .room-viz-scene {
        position: relative;
        background: linear-gradient(180deg, #a9afc6 0%, #c0c3d2 42%, #b8bccd 100%);
        height: 548px;
        overflow: hidden;
      }
      .room-viz-scene svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .room-viz-scene .noise-wave {
        transform-box: fill-box;
        transform-origin: center;
        animation: roomVizPulse 1.25s ease-out infinite;
      }
      .room-viz-scene .noise-wave.w2 { animation-delay: .28s; }
      .room-viz-scene .noise-wave.w3 { animation-delay: .56s; }
      @keyframes roomVizPulse {
        0% { opacity: .95; transform: scale(.9); }
        65% { opacity: .18; transform: scale(1.08); }
        100% { opacity: 0; transform: scale(1.18); }
      }
      .room-viz-scene .draft {
        animation: roomVizDraft 1.5s linear infinite;
      }
      .room-viz-scene .draft.d2 { animation-delay: .4s; }
      .room-viz-scene .draft.d3 { animation-delay: .8s; }
      @keyframes roomVizDraft {
        from { transform: translateX(0); opacity: 0; }
        15% { opacity: .85; }
        to { transform: translateX(38px); opacity: 0; }
      }
      @media (max-width: 900px) {
        .room-details-split { grid-template-columns: 1fr; }
        .room-viz-scene { height: 500px; }
      }
    </style>

      <main>
        <div style="margin-bottom: 1rem;">
          <a href="/house/<%= encodeURIComponent(room.dorm) %>/<%= encodeURIComponent(room.house) %>" style="display:inline-flex; align-items:center; gap:0.45rem; font-weight:600; font-size:0.9rem; color:#800000; text-decoration:none; padding:0.45rem 0.9rem; background:rgba(128,0,0,0.07); border:1px solid rgba(128,0,0,0.18); border-radius:2rem; transition:background 0.15s, box-shadow 0.15s;" onmouseover="this.style.background='rgba(128,0,0,0.14)'" onmouseout="this.style.background='rgba(128,0,0,0.07)'">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#800000"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            View all <%= room.house %> rooms
          </a>
        </div>
        <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
          <% 
            let displayCustomName = null;
            if (allEntries && allEntries.length > 0) {
              for (let i = allEntries.length - 1; i >= 0; i--) {
                if (allEntries[i].customName) {
                  displayCustomName = allEntries[i].customName;
                  break;
                }
              }
            }
          %>
          <div style="flex: 1; min-width: 0; padding-right: 1rem;">
            <% if (displayCustomName) { %>
              <h1 class="custom-room-name"><%= displayCustomName %></h1>
              <h2 style="font-weight: normal; margin-top: 0.4rem; color: var(--text-secondary); font-size: 1.25rem; margin-bottom: 0;">
                (<em><%= room.dorm %> - <%= room.house %> <%= room.roomNumber %></em>)
              </h2>
            <% } else { %>
              <h1 style="margin: 0;">
                <%= room.dorm %> - <%= room.house %> <%= room.roomNumber %>
              </h1>
            <% } %>
          </div>
        </div>

