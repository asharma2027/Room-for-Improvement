        </section>
        <div class="stat-card" id="latest-submission-card" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
            <h2 style="margin-top: 0; border: none;">Latest Submission</h2>
            <!-- Submit Review CTA -->
            <% if (!alreadySubmittedThisYear) { %>
              <a href="/rooms/<%= room.id %>/review" class="review-cta-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.21a.996.996 0 0 0 0-1.41l-2.34-2.34a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                </svg>
                Submit Your Data &rarr;
              </a>
            <% } else { %>
              <div style="background: #fee2e2; color: #b91c1c; padding: 0.6rem 1rem; border-radius: 0.5rem; border: 1px solid #fecaca; font-size: 0.9rem;">
                Already submitted for <strong><%= alreadySubmittedThisYear %></strong>
              </div>
            <% } %>
          </div>

          <% if (latestEntry) { %>
            <p style="color: var(--text-secondary); margin-bottom: 1rem;">
              <strong>Academic Year:</strong>
              <%= latestEntry.academicYear %>
            </p>

            <%
              const roomSzLabels   = ["","Cramped","Small","Average","Spacious","Very Spacious"];
              const lightLabels    = ["","Very Dark","Dark","Average","Bright","Very Bright"];
              const noiseLabels    = ["","Very Loud","Loud","Average","Quiet","Very Quiet"];
              const tempLabels     = ["","Very Poor","Poor","Average","Good","Excellent"];
              const cultureLabels  = ["","Very Poor","Poor","Average","Good","Excellent"];

              function ratingColor(val) {
                const colors = { 5: '#34877A', 4: '#92B89D', 3: '#D69772', 2: '#C27654', 1: '#AE5436' };
                return colors[Math.round(val)] || 'transparent';
              }
              function ratingTextColor(val) {
                return '#fff';
              }
              function noiseColor(val) {
                var colors = { 1: '#34877A', 2: '#92B89D', 3: '#D69772', 4: '#C27654', 5: '#AE5436' };
                return colors[Math.round(val)] || 'transparent';
              }
              function noiseTextColor(val) {
                return '#fff';
              }
            %>
            <div style="background: #f9f9f9; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
              <h4 style="margin-top: 0;">Ratings (1–5)</h4>
              <table class="ratings-table">
                <% if (latestEntry.scalars && latestEntry.scalars["room size"]) { %>
                <% const rsVal = latestEntry.scalars["room size"]; %>
                <tr style="background-color: <%= ratingColor(rsVal) %>; color: <%= ratingTextColor(rsVal) %>; font-weight: 700;">
                  <td class="rating-label">Room Size</td>
                  <td class="rating-value"><%= roomSzLabels[rsVal] || rsVal %> (<strong><%= rsVal %>/5</strong>)</td>
                </tr>
                <% } %>
                <% if (latestEntry.scalars && latestEntry.scalars["natural light"]) { %>
                <% const nlVal = latestEntry.scalars["natural light"]; %>
                <tr style="background-color: <%= ratingColor(nlVal) %>; color: <%= ratingTextColor(nlVal) %>; font-weight: 700;">
                  <td class="rating-label">Natural Light</td>
                  <td class="rating-value"><%= lightLabels[nlVal] || nlVal %> (<strong><%= nlVal %>/5</strong>)</td>
                </tr>
                <% } %>
                <% if (latestEntry.scalars && latestEntry.scalars["my room gets a lot of outside noise"]) { %>
                <% const onVal = latestEntry.scalars["my room gets a lot of outside noise"]; %>
                <tr style="background-color: <%= noiseColor(onVal) %>; color: <%= noiseTextColor(onVal) %>; font-weight: 700;">
                  <td class="rating-label">Outside Noise</td>
                  <td class="rating-value"><%= noiseLabels[onVal] || onVal %> (<strong><%= onVal %>/5</strong>)</td>
                </tr>
                <% } %>
                <% if (latestEntry.scalars && latestEntry.scalars["temperature control"]) { %>
                <% const tcVal = latestEntry.scalars["temperature control"]; %>
                <tr style="background-color: <%= ratingColor(tcVal) %>; color: <%= ratingTextColor(tcVal) %>; font-weight: 700;">
                  <td class="rating-label">Temperature Control</td>
                  <td class="rating-value"><%= tempLabels[tcVal] || tcVal %> (<strong><%= tcVal %>/5</strong>)</td>
                </tr>
                <% } %>
                <% if (latestEntry.scalars && latestEntry.scalars["my house has a good culture"]) { %>
                <% const hcVal = latestEntry.scalars["my house has a good culture"]; %>
                <tr style="background-color: <%= ratingColor(hcVal) %>; color: <%= ratingTextColor(hcVal) %>; font-weight: 700;">
                  <td class="rating-label">House Culture</td>
                  <td class="rating-value"><%= cultureLabels[hcVal] || hcVal %> (<strong><%= hcVal %>/5</strong>)</td>
                </tr>
                <% } %>
              </table>
            </div>

            <% if (latestEntry.cultureTags && latestEntry.cultureTags.length > 0) { %>
            <div style="margin-bottom: 1rem;">
              <h4 style="margin-bottom: 0.5rem;">House Culture Descriptors</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                <% latestEntry.cultureTags.forEach(ct => { %>
                  <span class="tag"><%= ct %></span>
                <% }) %>
              </div>
            </div>
            <% } %>

            <% if (latestEntry.scalars && latestEntry.scalars["culture note"]) { %>
            <p style="margin-bottom: 0.75rem; font-size: 0.9rem;">
              <strong>Culture note:</strong> <em>"<%= latestEntry.scalars["culture note"] %>"</em>
            </p>
            <% } %>

            <% if (latestEntry.scalars && latestEntry.scalars["house descriptor"]) { %>
            <p style="margin-bottom: 0.75rem; font-size: 0.9rem;">
              <strong>House Descriptor:</strong> <em><%= latestEntry.scalars["house descriptor"] %></em>
            </p>
            <% } %>

            <% if (latestEntry.scalars && latestEntry.scalars["freetext note"]) { %>
            <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 0.4rem; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.9rem;">
              <strong>Room note:</strong> <%= latestEntry.scalars["freetext note"] %>
            </div>
            <% } %>

            <div style="margin-bottom: 0.5rem;">
              <h4 style="margin-bottom: 0.5rem;">Physical Tags</h4>
              <% if (latestEntry.tags && latestEntry.tags.length > 0) { %>
                <% latestEntry.tags.forEach(tag => { %>
                  <span class="tag"><%= tag %></span>
                <% }) %>
              <% } else { %>
                <span style="color: var(--text-secondary); font-style: italic;">None selected</span>
              <% } %>
            </div>

          <% } else { %>
            <p><em>No prior submissions for this room.</em></p>
          <% } %>
        </div>
        </div>

        <!-- Historical Data -->
        <div class="wrapper">
          <h3 style="border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem;">Historical Data</h3>
          <% if (allEntries && allEntries.length > 0) { %>
            <p>Below are all previous submissions for this room (oldest first):</p>
            <div style="margin-top: 1rem;">
              <%- include('partials/roomHistory') %>
            </div>
          <% } else { %>
            <p class="text-secondary">No data available yet. Be the first to add some!</p>
          <% } %>
        </div>

      </main>

      <footer>
        <p>&copy; 2025 Room for Improvement</p>
      </footer>

      <!-- Highlight card if redirected after form submit -->
      <script>
        (function() {
          var params = new URLSearchParams(window.location.search);
          if (params.get('submitted') === '1') {
            var card = document.getElementById('latest-submission-card');
            if (card) {
              card.classList.add('review-just-submitted');
              // scroll into view
              card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            // Clean URL without refresh
            var newUrl = window.location.pathname;
            history.replaceState({}, '', newUrl);
          }
        })();
      </script>
      <script>
        (function() {
          var vizScalars = {
            'room size': <%- JSON.stringify((latestEntry && latestEntry.scalars && latestEntry.scalars['room size']) || null) %>,
            'natural light': <%- JSON.stringify((latestEntry && latestEntry.scalars && latestEntry.scalars['natural light']) || null) %>,
            'my room gets a lot of outside noise': <%- JSON.stringify((latestEntry && latestEntry.scalars && latestEntry.scalars['my room gets a lot of outside noise']) || null) %>,
            'temperature control': <%- JSON.stringify((latestEntry && latestEntry.scalars && latestEntry.scalars['temperature control']) || null) %>,
            'my house has a good culture': <%- JSON.stringify((latestEntry && latestEntry.scalars && latestEntry.scalars['my house has a good culture']) || null) %>
          };
          var vizTags = <%- JSON.stringify((latestEntry && latestEntry.tags) ? latestEntry.tags : []) %>;

          function clampScore(val, fallback) {
            var n = Number(val);
            if (!isFinite(n)) return fallback;
            n = Math.round(n);
            if (n < 1) return 1;
            if (n > 5) return 5;
            return n;
          }

          function hasTag(needle) {
            var n = String(needle).toLowerCase();
            return (vizTags || []).some(function(t) {
              return String(t).toLowerCase().indexOf(n) !== -1;
            });
          }

          var $ = function(id) { return document.getElementById(id); };

          function setPoints(el, pts) {
            el.setAttribute('points', pts.map(function(p) { return p[0] + ',' + p[1]; }).join(' '));
          }

          var personFigure = {
            fill: '#0c1117',
            stroke: '#ffffff',
            outlineWidth: 8,
            limbWidth: 5.2,
            headRadius: 17,
            torso: { x: -15, y: 19, width: 30, height: 61, rx: 12 },
            legs: {
              left: { x: -20, y: 72, width: 14, height: 43, rx: 4 },
              right: { x: 6, y: 72, width: 14, height: 43, rx: 4 }
            }
          };

          var poseLibrary = {
            mope: {
              bodyRotate: 12, headDx: 4, headDy: 5,
              leftArm: { x1: -14, y1: 33, x2: -17, y2: 67 },
              rightArm: { x1: 14, y1: 33, x2: 17, y2: 67 }
            },
            low: {
              bodyRotate: 6, headDx: 2, headDy: 2,
              leftArm: { x1: -14, y1: 33, x2: -24, y2: 62 },
              rightArm: { x1: 14, y1: 33, x2: 24, y2: 62 }
            },
            neutral: {
              bodyRotate: 0, headDx: 0, headDy: 0,
              leftArm: { x1: -14, y1: 32, x2: -30, y2: 50 },
              rightArm: { x1: 14, y1: 32, x2: 30, y2: 50 }
            },
            social: {
              bodyRotate: -2, headDx: 0, headDy: -0.5,
              leftArm: { x1: -14, y1: 32, x2: -34, y2: 8 },
              rightArm: { x1: 14, y1: 32, x2: 34, y2: 8 }
            },
            happy: {
              bodyRotate: -3, headDx: 0, headDy: -1,
              leftArm: { x1: -14, y1: 32, x2: -34, y2: -4 },
              rightArm: { x1: 14, y1: 32, x2: 34, y2: -4 }
            }
          };

          function limbMarkup(x1, y1, x2, y2) {
            return ''
              + '<line x1="' + x1 + '" y1="' + y1 + '" x2="' + x2 + '" y2="' + y2 + '" stroke="' + personFigure.stroke + '" stroke-width="' + personFigure.outlineWidth + '" stroke-linecap="round"/>'
              + '<line x1="' + x1 + '" y1="' + y1 + '" x2="' + x2 + '" y2="' + y2 + '" stroke="' + personFigure.fill + '" stroke-width="' + personFigure.limbWidth + '" stroke-linecap="round"/>';
          }

          function personMarkup(cfg) {
            cfg = cfg || {};
            var x = cfg.x || 0;
            var y = cfg.y || 0;
            var scale = cfg.scale == null ? 1 : cfg.scale;
            var p = poseLibrary[cfg.pose] || poseLibrary.neutral;
            return ''
              + '<g transform="translate(' + x + ' ' + y + ') scale(' + scale + ')">'
              + '<g transform="rotate(' + p.bodyRotate + ' 0 30)">'
              + limbMarkup(p.leftArm.x1, p.leftArm.y1, p.leftArm.x2, p.leftArm.y2)
              + limbMarkup(p.rightArm.x1, p.rightArm.y1, p.rightArm.x2, p.rightArm.y2)
              + '<rect x="' + personFigure.torso.x + '" y="' + personFigure.torso.y + '" width="' + personFigure.torso.width + '" height="' + personFigure.torso.height + '" rx="' + personFigure.torso.rx + '" fill="' + personFigure.fill + '" stroke="' + personFigure.stroke + '" stroke-width="3"/>'
              + '<rect x="' + personFigure.legs.left.x + '" y="' + personFigure.legs.left.y + '" width="' + personFigure.legs.left.width + '" height="' + personFigure.legs.left.height + '" rx="' + personFigure.legs.left.rx + '" fill="' + personFigure.fill + '" stroke="' + personFigure.stroke + '" stroke-width="3"/>'
              + '<rect x="' + personFigure.legs.right.x + '" y="' + personFigure.legs.right.y + '" width="' + personFigure.legs.right.width + '" height="' + personFigure.legs.right.height + '" rx="' + personFigure.legs.right.rx + '" fill="' + personFigure.fill + '" stroke="' + personFigure.stroke + '" stroke-width="3"/>'
              + '</g>'
              + '<circle cx="' + p.headDx + '" cy="' + p.headDy + '" r="' + personFigure.headRadius + '" fill="' + personFigure.fill + '" stroke="' + personFigure.stroke + '" stroke-width="3"/>'
              + '</g>';
          }

          function cultureLayout(score) {
            switch (score) {
              case 1:
                return [
                  {x: 24, y: 10, scale: 0.46, pose: 'mope'},
                  {x: 88, y: 4, scale: 0.46, pose: 'mope'},
                  {x: 150, y: 12, scale: 0.46, pose: 'mope'},
                  {x: 52, y: 70, scale: 0.46, pose: 'mope'},
                  {x: 122, y: 74, scale: 0.46, pose: 'mope'}
                ];
              case 2:
                return [
                  {x: 34, y: 10, scale: 0.46, pose: 'low'},
                  {x: 88, y: 6, scale: 0.46, pose: 'low'},
                  {x: 142, y: 12, scale: 0.46, pose: 'low'},
                  {x: 62, y: 66, scale: 0.46, pose: 'neutral'},
                  {x: 116, y: 70, scale: 0.46, pose: 'low'}
                ];
              case 3:
                return [
                  {x: 44, y: 8, scale: 0.46, pose: 'neutral'},
                  {x: 92, y: 4, scale: 0.46, pose: 'neutral'},
                  {x: 140, y: 8, scale: 0.46, pose: 'neutral'},
                  {x: 68, y: 62, scale: 0.46, pose: 'neutral'},
                  {x: 116, y: 62, scale: 0.46, pose: 'neutral'}
                ];
              case 4:
                return [
                  {x: 56, y: 8, scale: 0.46, pose: 'social'},
                  {x: 96, y: 0, scale: 0.46, pose: 'social'},
                  {x: 136, y: 8, scale: 0.46, pose: 'social'},
                  {x: 74, y: 58, scale: 0.46, pose: 'social'},
                  {x: 118, y: 58, scale: 0.46, pose: 'social'}
                ];
              case 5:
              default:
                return [
                  {x: 60, y: 8, scale: 0.46, pose: 'happy'},
                  {x: 98, y: 0, scale: 0.46, pose: 'happy'},
                  {x: 136, y: 8, scale: 0.46, pose: 'happy'},
                  {x: 76, y: 58, scale: 0.46, pose: 'happy'},
                  {x: 118, y: 58, scale: 0.46, pose: 'happy'}
                ];
            }
          }

          function renderCulturePeople(score) {
            $('culturePeople').innerHTML = cultureLayout(score).map(function(cfg) { return personMarkup(cfg); }).join('');
          }

          function renderMainPerson() {
            $('person').innerHTML = personMarkup({x: 0, y: 0, scale: 1, pose: 'neutral'});
          }

          function updateWindowGeometry(outer, inner) {
            setPoints($('windowGlass'), inner);
            setPoints($('windowClipShape'), inner);
            setPoints($('windowCutout'), inner);
            setPoints($('windowFrameTop'), [outer[0], outer[1], inner[1], inner[0]]);
            setPoints($('windowFrameRight'), [outer[1], outer[2], inner[2], inner[1]]);
            setPoints($('windowFrameBottom'), [outer[2], outer[3], inner[3], inner[2]]);
            setPoints($('windowFrameLeft'), [outer[3], outer[0], inner[0], inner[3]]);

            function mid(a, b) { return [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2]; }
            var topMid = mid(inner[0], inner[1]);
            var bottomMid = mid(inner[3], inner[2]);
            var leftMid = mid(inner[0], inner[3]);
            var rightMid = mid(inner[1], inner[2]);
            $('windowMullionV').setAttribute('x1', topMid[0]);
            $('windowMullionV').setAttribute('y1', topMid[1]);
            $('windowMullionV').setAttribute('x2', bottomMid[0]);
            $('windowMullionV').setAttribute('y2', bottomMid[1]);
            $('windowMullionH').setAttribute('x1', leftMid[0]);
            $('windowMullionH').setAttribute('y1', leftMid[1]);
            $('windowMullionH').setAttribute('x2', rightMid[0]);
            $('windowMullionH').setAttribute('y2', rightMid[1]);

            var gx1 = inner[0][0] + (inner[1][0] - inner[0][0]) * 0.18;
            var gy1 = inner[0][1] + (inner[1][1] - inner[0][1]) * 0.18 + 5;
            var gx2 = inner[0][0] + (inner[1][0] - inner[0][0]) * 0.70;
            var gy2 = inner[0][1] + (inner[1][1] - inner[0][1]) * 0.70 + 9;
            $('windowGlint').setAttribute('d', 'M' + gx1 + ' ' + gy1 + ' L' + gx2 + ' ' + gy2);
          }

          function updateScene() {
            var size = clampScore(vizScalars['room size'], 3);
            var light = clampScore(vizScalars['natural light'], 3);
            var noise = clampScore(vizScalars['my room gets a lot of outside noise'], 3);
            var temp = clampScore(vizScalars['temperature control'], 3);
            var culture = clampScore(vizScalars['my house has a good culture'], 3);

            var s = 1 + (size - 3) * 0.045;
            var cx = 572, cy = 290;
            $('roomComposite').setAttribute('transform', 'translate(' + cx + ' ' + cy + ') scale(' + s + ') translate(' + (-cx) + ' ' + (-cy) + ')');

            var lightOpacity = 0.04 + light * 0.06;
            $('lightWash').setAttribute('opacity', lightOpacity);
            $('scene').style.filter = 'brightness(' + (0.84 + light * 0.075) + ') saturate(' + (0.94 + light * 0.03) + ')';

            var noiseIntensity = noise / 5;
            $('noiseVisual').style.opacity = Math.max(0.03, noiseIntensity);
            $('noiseVisual').style.transform = 'translate(300px, 300px) scale(' + (0.85 + noiseIntensity * 0.5) + ')';

            var coolScore = (temp - 1) / 4;
            var r = Math.round(232 - 105 * coolScore);
            var g = Math.round(127 + 104 * coolScore);
            var b = Math.round(96 + 159 * coolScore);
            var tempColor = 'rgb(' + r + ',' + g + ',' + b + ')';
            $('tempWash').setAttribute('fill', tempColor);
            $('tempWash').setAttribute('opacity', temp <= 2 ? 0.13 : 0.06);

            var thermostatColor = temp <= 3 ? '#ff8a5b' : '#76c7ff';
            $('thermoBulb').setAttribute('fill', thermostatColor);
            $('thermoMercury').setAttribute('fill', thermostatColor);
            $('thermoMercury').setAttribute('y', String(105 - temp * 13));
            $('thermoMercury').setAttribute('height', String(16 + temp * 13));

            renderCulturePeople(culture);

            var drafty = hasTag('drafty windows');
            var flex = hasTag('furniture layout flexibility');
            var smallWindows = hasTag('particularly small windows');

            $('draftVisual').style.display = drafty ? '' : 'none';
            $('furniture').style.display = flex ? '' : 'none';

            if (smallWindows) {
              updateWindowGeometry(
                [[681,199],[732,228],[732,292],[681,268]],
                [[689,205],[724,225],[724,283],[689,264]]
              );
            } else {
              updateWindowGeometry(
                [[672,189],[744,229],[744,308],[672,272]],
                [[682,196],[735,226],[735,298],[682,266]]
              );
            }
          }

          if ($('scene')) {
            renderMainPerson();
            updateScene();
          }
        })();
      </script>
  </body>

  </html>
