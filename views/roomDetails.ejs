                  <polygon id="windowFrameRight" points="732,228 732,292 724,283 724,225" fill="#666f7e" stroke="#59616f" stroke-width="1.4"/>
                  <polygon id="windowFrameBottom" points="732,292 681,268 689,264 724,283" fill="#5f6877" stroke="#59616f" stroke-width="1.4"/>
                  <polygon id="windowFrameLeft" points="681,268 681,199 689,205 689,264" fill="#7a8290" stroke="#59616f" stroke-width="1.4"/>
